ANTHROPIC_API_KEY=your_api_key_here
RG_PAPER_ANALYSIS_MODEL=claude-sonnet-4-6
RG_PAPER_ANALYSIS_INPUT_MODE=text_first
RG_PAPER_ANALYSIS_TEXT_CHAR_LIMIT=36000
RG_PAPER_ANALYSIS_PDF_PAGE_THRESHOLD=8
RG_SEARCH_MODEL=claude-sonnet-4-6
