RG_PDF_MAX_FILE_MB=32
RG_REQUEST_TIMEOUT_SECONDS=180
RG_SEARCH_TIMEOUT_SECONDS=60
RG_EXTRACTION_WORKERS=1
RG_PAIRWISE_WORKERS=1
RG_PAIRWISE_SERIAL_RETRY_ATTEMPTS=1
RG_PAIRWISE_MAX_TOKENS=2048
RG_PAIRWISE_FALLBACK_MAX_TOKENS=3072
